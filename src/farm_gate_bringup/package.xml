<?xml version="1.0"?>
<package format="3">
  <name>farm_gate_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch files for farm-gate coverage demo (Gazebo + Nav2 + FollowPath executor).</description>

  <maintainer email="caihao1B@example.com">caihao1B</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <exec_depend>coverage_manager</exec_depend>
  <exec_depend>coverage_metrics</exec_depend>
  <exec_depend>coverage_sim</exec_depend>

  <exec_depend>farm_gate_world</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
