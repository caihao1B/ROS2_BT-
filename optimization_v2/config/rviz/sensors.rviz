Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 32; 40; 48
    Fixed Frame: base_link
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground reference
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50
    - Class: rviz_default_plugins/TF
      Name: Calibrated sensor frames
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Native 32-line lidar
      Enabled: true
      Topic:
        Value: /s04/lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 3
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: Left rectified
      Enabled: true
      Topic:
        Value: /s04/stereo/left/image_rect
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 3
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Name: Right rectified
      Enabled: true
      Topic:
        Value: /s04/stereo/right/image_rect
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 3
      Transport Hint: raw
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point: {X: 4, Y: 0, Z: 0}
      Pitch: 0.5
      Yaw: 3.7
Window Geometry:
  Width: 1280
  Height: 850
  X: 40
  Y: 60
