Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 28; 38; 48
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Metre grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 40
  - Class: rviz_default_plugins/TF
    Name: Unique local TF
    Enabled: true
    Show Names: true
    Marker Scale: 0.3
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw observed lidar (toggle)
    Enabled: false
    Topic:
      Value: /s04/perception/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (Pixels): 2
    Style: Points
    Color Transformer: AxisColor
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: Measured terrain green / hazard red
    Enabled: true
    Topic:
      Value: /s09/terrain/colored
      Reliability Policy: Reliable
      Depth: 2
    Style: Points
    Size (Pixels): 3
    Color Transformer: RGB8
    Position Transformer: XYZ
  - Class: rviz_default_plugins/Map
    Name: Diff Nav2 costmap
    Enabled: true
    Topic:
      Value: /s09_nav2/diff/costmap
      Reliability Policy: Reliable
      Depth: 2
    Alpha: 0.55
    Color Scheme: costmap
  - Class: rviz_default_plugins/Map
    Name: Ackermann Nav2 costmap (toggle)
    Enabled: false
    Topic:
      Value: /s09_nav2/ackermann/costmap
      Reliability Policy: Reliable
      Depth: 2
    Alpha: 0.55
    Color Scheme: costmap
  - Class: rviz_default_plugins/MarkerArray
    Name: Observed tracks and IDs
    Enabled: true
    Topic:
      Value: /s09/objects/markers
      Reliability Policy: Reliable
      Depth: 2
  - Class: rviz_default_plugins/Image
    Name: Actual camera detections
    Enabled: true
    Topic:
      Value: /s09/camera/annotated
      Reliability Policy: Reliable
      Depth: 2
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 4
        Y: 0
        Z: 0.5
      Pitch: 0.7
      Yaw: 0.1
Window Geometry:
  Width: 1280
  Height: 850
  X: 40
  Y: 60
