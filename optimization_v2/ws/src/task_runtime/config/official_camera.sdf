<?xml version="1.0"?>
<sdf version="1.9"><world name="r01_camera">
<physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<model name="camera"><static>true</static><link name="link"><sensor name="camera" type="camera"><topic>/r01/camera</topic><always_on>true</always_on><update_rate>10</update_rate><camera><horizontal_fov>1</horizontal_fov><image><width>64</width><height>48</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera></sensor></link></model>
</world></sdf>
